# Google Cloud project with Places API (New) enabled and billing configured.
# Restrict this server key to Places API (New); never use NEXT_PUBLIC_ for it.
GOOGLE_MAPS_PLACES_API_KEY=

# Optional map embed key. Restrict to Maps Embed API and your web referrers (localhost + production host).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Local PostgreSQL (Compose binds only to loopback; choose a random hex password).
POSTGRES_DB=aarogya_setu
POSTGRES_USER=aarogya_local
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aarogya_local:REPLACE_WITH_HEX_PASSWORD@127.0.0.1:5432/aarogya_setu

# 32 random bytes, base64 encoded. Used for AES-256-GCM encryption of patient mobile numbers.
PATIENT_MOBILE_ENCRYPTION_KEY=

# Independent random key for exact-match lookup without storing a plain mobile number.
PATIENT_LOOKUP_PEPPER=

